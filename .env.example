# ─── 網站 ───────────────────────────────────────────────
# 寄信時組連結用的網址（本機可留空，會用 http://localhost:3000）
APP_URL=

# ─── 資料庫 ─────────────────────────────────────────────
# Supabase → Project Settings → Database → Connection string（Transaction pooler, port 6543）
# 留空時，本機會自動改用內嵌的 PGlite（資料存在 .data/pglite）
DATABASE_URL=

# ─── Supabase Storage（照片、主視覺） ─────────────────────
# 留空時，照片存在本機 .data/uploads
NEXT_PUBLIC_SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_STORAGE_BUCKET=public-media

# ─── 後台：第一個超級管理員 ───────────────────────────────
SUPER_ADMIN_EMAIL=
SUPER_ADMIN_PASSWORD=

# ─── 寄信：有 RESEND_API_KEY 就用 Resend，否則用下面的 Gmail
RESEND_API_KEY=
# 沒有自己的網域時留空（預設 onboarding@resend.dev，只寄得到註冊 Resend 的信箱）
MAIL_FROM=
# ─── 寄信（Gmail SMTP + 應用程式密碼） ────────────────────
# 留空時不會真的寄出，信件內容寫進資料庫，本機可在 /dev/mailbox 查看
GMAIL_USER=leftbank.psy@gmail.com
GMAIL_APP_PASSWORD=

# ─── 職涯羅盤：分流 Agent（Anthropic Claude API） ───────────
# 沒有金鑰時，本機會用示範模式產生生涯報告（流程照常跑）
ANTHROPIC_API_KEY=
# 系友故事自動標籤用的模型
AI_MODEL=claude-haiku-5-5
# 分流 Agent 用的模型；品質不足時可改 claude-sonnet-5-5 或 claude-opus-5-5
AGENT_MODEL=claude-haiku-5-5
# /api/agent/run 的內部驗證（正式環境必填；留空時 Agent 直接在送出問卷的同一個請求的 after() 裡執行）
AGENT_SECRET=
# Agent 預設會上網查臺大與政府網站的資訊（web_search / web_fetch，限白名單網域）；設成 off 才關閉
AGENT_WEB=on
# 每位使用者每 30 天最多幾次 Agent（超過時只顯示固定推薦）
AGENT_MAX_PER_USER_30D=3
# 宣傳期（ISO 日期，含當天）。期間外只顯示固定推薦
AI_PROMO_START=
AI_PROMO_END=
# 全站總預算（美元），用完自動改顯示固定推薦
AI_TOTAL_BUDGET_USD=50

# ─── 排程（Vercel Cron 會帶 Authorization: Bearer $CRON_SECRET） ─
CRON_SECRET=
SITE_GATE_PASSWORD=
