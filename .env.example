# ─── 網站 ───────────────────────────────────────────────
# 寄信時組連結用的網址（本機可留空，會用 http://localhost:3000）
APP_URL=

# ─── 資料庫 ─────────────────────────────────────────────
# Supabase → Project Settings → Database → Connection string（Transaction pooler, port 6543）
# 留空時，本機會自動改用內嵌的 PGlite（資料存在 .data/pglite）
DATABASE_URL=

# ─── Supabase Storage（照片、主視覺） ─────────────────────
# 留空時，照片存在本機 .data/uploads
NEXT_PUBLIC_SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_STORAGE_BUCKET=public-media

# ─── 後台：第一個超級管理員 ───────────────────────────────
SUPER_ADMIN_EMAIL=
SUPER_ADMIN_PASSWORD=

# ─── 寄信：有 RESEND_API_KEY 就用 Resend，否則用下面的 Gmail
RESEND_API_KEY=
# 沒有自己的網域時留空（預設 onboarding@resend.dev，只寄得到註冊 Resend 的信箱）
MAIL_FROM=
# ─── 寄信（Gmail SMTP + 應用程式密碼） ────────────────────
# 留空時不會真的寄出，信件內容寫進資料庫，本機可在 /dev/mailbox 查看
GMAIL_USER=leftbank.psy@gmail.com
GMAIL_APP_PASSWORD=

# ─── AI 生涯對談（Anthropic Claude API） ──────────────────
ANTHROPIC_API_KEY=
# 預設 claude-opus-5-5；想降低成本可改 claude-sonnet-5-5 或 claude-haiku-5-5
AI_MODEL=claude-opus-5-5
# 宣傳期（ISO 日期，含當天）。沒設定代表不在宣傳期，畫面顯示「即將推出」
AI_PROMO_START=
AI_PROMO_END=
# 全站總預算（美元），用完自動關閉
AI_TOTAL_BUDGET_USD=50
# 每次對談最多幾輪（學生發言的次數）
AI_MAX_TURNS=8

# ─── 排程（Vercel Cron 會帶 Authorization: Bearer $CRON_SECRET） ─
CRON_SECRET=
SITE_GATE_PASSWORD=
